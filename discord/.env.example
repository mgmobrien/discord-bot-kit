# Copy this file to .env and fill both values in.
#   cp .env.example .env
#
# .env is gitignored. Never commit it. Never paste the token into a chat
# message, an issue, or a command-line argument.

# From the Discord Developer Portal: your application -> Bot -> Reset Token.
# Shown only once; reset it again if you lose it.
DISCORD_BOT_TOKEN=

# The channel the bot should read and post in.
# Leave blank at first, then run:  python3 bot.py channels
DISCORD_CHANNEL_ID=
