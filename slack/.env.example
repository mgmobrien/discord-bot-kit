# Slack bot credentials. Copy to .env in this directory:  cp .env.example .env
# .env is gitignored. Never commit it, never paste a token into a message, and never pass
# one as a command-line argument -- arguments land in shell history and are visible in the
# process list while the command runs.

# BOT token, from Install App -> Install to Workspace. Acts as the bot. Used by almost
# everything. Starts xoxb-
SLACK_BOT_TOKEN=

# USER token, from the same page after installing for yourself. Acts as YOU, with your
# access to every channel you are in. This kit uses it only where Slack offers no bot
# equivalent, and names the reason at each call site. Starts xoxp-
# Optional: leave empty and every command that does not need it still works.
SLACK_USER_TOKEN=

# Default channel ID for commands run without --channel. Optional.
# Get it from:  python3 bot.py channels
# This is an ID (C…), not a name -- names are ambiguous and can be changed by anyone.
SLACK_CHANNEL_ID=
